        "        \"Mauritius\",\n",
        "        \"French Guiana\"\n",
        "    ],\n",
        "    \"Year\": [1981, 2001, 1973, 2015, 1970, 2004, 2006, 2015, 1999, 2004],\n",
        "    \"Quantity\": [5148, 3262, 9119, 3097, 3356, 2474, 4081, 6576, 2460, 1831],\n",
        "    \"UnitPrice\": [545, 383, 407, 615, 91, 136, 195, 603, 36, 664],\n",
        "    \"transactionComplete\": [\n",
        "        False, False, True, False, True,\n",
