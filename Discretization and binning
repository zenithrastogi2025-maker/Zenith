        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "height = [120, 122, 125, 127, 121, 123, 137, 131, 161, 145, 141, 132]\n",
        "\n",
        "bins = [118, 125, 135, 160, 200]\n",
        "\n",
        "category = pd.cut(height, bins)\n",
        "\n",
        "print(\"Discretization and Binning:\")\n",
        "print(category)\n",
        "\n",
        "print(\"\\nNumber of values in each bin:\")\n",
        "print(pd.Series(category).value_counts())\n",
        "\n",
        "bin_names = [\n",
        "    \"Short Height\",\n",
        "    \"Average Height\",\n",
        "    \"Good Height\",\n",
        "    \"Taller\"\n",
        "]\n",
        "\n",
        "category = pd.cut(\n",
        "    height,\n",
        "    bins,\n",
        "    labels=bin_names\n",
        ")\n",
        "\n",
        "print(\"\\nBinning with Labels:\")\n",
        "print(category)\n",
        "\n",
        "random_numbers = np.random.rand(40)\n",
        "\n",
        "category2 = pd.cut(\n",
        "    random_numbers,\n",
        "    5,\n",
        "    precision=2\n",
        ")\n",
        "\n",
        "print(\"\\nEqual Length Bins:\")\n",
        "print(category2)\n",
        "\n",
        "randomNumbers = np.random.rand(2000)\n",
        "\n",
        "category3 = pd.qcut(\n",
        "    randomNumbers,\n",
        "    4\n",
        ")\n",
        "\n",
        "print(\"\\nQuantile Binning:\")\n",
        "print(category3)\n",
        "\n",
        "print(\"\\nValues in Each Quantile:\")\n",
        "print(pd.Series(category3).value_counts())\n",
        "\n",
